---
import steffi from "../../assets/images/steffi01.jpg";
import nelly from "../../assets//images/dogs/nelly01.jpg";
import scotti from "../../assets/images/dogs/scotti01.jpg";
import emma from "../../assets/images/dogs/emma01.jpg";
import jimmy from "../../assets/images/dogs/jimmy01.jpg";
import kalle from "../../assets/images/dogs/kalle01.jpg";

import Dog from "./Dog.astro";
---

<section class="bg-white">
  <div class="container px-6 py-10 mx-auto">
    <h1 class="text-2xl font-semibold text-center text-gray-800 lg:text-3xl">
      Wer sind <span class="text-blue-500">wir?</span>
    </h1>

    <div class="grid grid-cols-1 gap-8 mt-8 xl:mt-12 xl:gap-16 md:grid-cols-2">
      <Dog image={steffi} name="Steffi">
        <p>
          Mein Name ist Steffi Kostka und außer den Hunden wohnen im Haushalt
          noch mein Mann Hans und die drei Kinder Johanna, Carina und Rosalie.
        </p>
        <div class="mt-4 p-4 bg-blue-50 border-l-4 border-blue-500 rounded">
          <p class="text-sm font-semibold text-blue-800 mb-1">
            ✓ Zertifizierte Hundebesuchs&shy;dienst&shy;leisterin
          </p>
          <p class="text-sm text-gray-700">
            Sachkundenachweis nach § 11 TierSchG für die gewerbliche
            Hundehaltung
          </p>
        </div>
      </Dog>

      <Dog image={emma} name="Emma">
        <p>
          Emma ist am 29.06.2016 geboren und ein apricotfarbener sehr
          feinfühliger Labradoodle, sie wiegt 19 kg. Emma ist der ruhende Pol in
          unserem Rudel.
        </p>
      </Dog>
      <Dog image={nelly} name="Nelly">
        <p>
          Nelly ist am 31.07.2019 geboren und unsere besonders freundliche
          Labradoodlehündin. Sie hat schwarzes wuscheliges Fell und wiegt 27 kg.
          Ihre Lieblingsbeschäftigungen sind schmusen und ballspielen.
        </p>
      </Dog>
      <Dog image={jimmy} name="Jimmy">
        <p>
          Jimmy ist am 13.02.2023 geboren und unser putziger 8 kg leichter
          Cavapoo. Seine Mama ist ein Cavalier King Charles Spaniel und sein
          Papa ein kleiner Pudel. Aufgrund seiner großen Kulleraugen kann man
          ihm nie böse sein.
        </p>
      </Dog>
      <Dog image={kalle} name="Kalle (Karlchen)">
        <p>
          Karlchen ist ein kleiner brauner Labrador mit 22 kg. Er ist der Jüngste
          (geboren am 01.09.2025) und Witzigste des Rudels. Der Spaßvogel ist
          immer bereit für Schabernack und möchte alles richtig machen.
        </p>
      </Dog>
      <Dog image={scotti} name="Scotti" memorial={true}>
        <p class="text-gray-700">
          <span class="font-semibold">26.04.2013 - 07.11.2025</span>
        </p>
        <p class="text-gray-700">
          Scotti war ein Labradoodle, eine Mischung aus Labrador und Großpudel,
          geboren in Niederlauterbach in der Hallertau. Er wog 30 kg.
        </p>
        <p class="text-gray-700">
          Scottis Lieblingsbeschäftigungen waren schlafen, gekrault werden,
          fressen und spielen mit seinen Hundefreunden.
        </p>
      </Dog>
    </div>
  </div>
</section>
